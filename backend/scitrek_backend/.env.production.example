# Copy to .env on the production host. Replace every change-me value.
DJANGO_SETTINGS_MODULE=scitrek_backend.settings.production
DJANGO_SECRET_KEY=change-me-use-a-long-random-secret
DJANGO_ALLOWED_HOSTS=sci-trek.org,www.sci-trek.org
DJANGO_HEALTHCHECK_HOST=sci-trek.org
CORS_ALLOWED_ORIGINS=https://sci-trek.org,https://www.sci-trek.org
CSRF_TRUSTED_ORIGINS=https://sci-trek.org,https://www.sci-trek.org

DATABASE_ENGINE=postgresql
DATABASE_HOST=change-me-managed-postgresql-host
DATABASE_PORT=5432
DATABASE_NAME=change-me-database-name
DATABASE_USER=change-me-database-user
DATABASE_PASSWORD=change-me-database-password
DATABASE_SSLMODE=require
DATABASE_CONN_MAX_AGE=60
DATABASE_WAIT_MAX_ATTEMPTS=30
DATABASE_WAIT_INTERVAL_SECONDS=2

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_CACHE_URL=redis://redis:6379/2
TRUSTED_PROXY_COUNT=1

# Disabled by default. If enabled, guests may enter only this demo classroom.
GUEST_LOGIN_ENABLED=0
GUEST_CLASSROOM_NAME=1001
# Keep disabled until opaque join codes or teacher approval are implemented.
PUBLIC_SIGNUP_ENABLED=0

# Used by Docker Compose/nginx/certificate operations; never secrets.
TLS_DOMAIN=sci-trek.org
TLS_WWW_DOMAIN=www.sci-trek.org
TLS_EMAIL=change-me-operations-email

# Empty means same-origin API requests, which is recommended in production.
VITE_API_BASE_URL=
