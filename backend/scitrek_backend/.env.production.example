# Copy to .env on the production host. Replace every change-me value.
DJANGO_SETTINGS_MODULE=scitrek_backend.settings.production
DJANGO_SECRET_KEY=change-me-use-a-long-random-secret
DJANGO_ALLOWED_HOSTS=bioinformatics-mod.sci-trek.org
DJANGO_HEALTHCHECK_HOST=bioinformatics-mod.sci-trek.org
CORS_ALLOWED_ORIGINS=https://bioinformatics-mod.sci-trek.org
CSRF_TRUSTED_ORIGINS=https://bioinformatics-mod.sci-trek.org

DATABASE_ENGINE=postgresql
# AWS RDS: use the instance endpoint, e.g.
#   scitrek-bioinformatics-mod.abcdef123456.us-west-2.rds.amazonaws.com
DATABASE_HOST=change-me-managed-postgresql-host
DATABASE_PORT=5432
DATABASE_NAME=change-me-database-name
DATABASE_USER=change-me-database-user
DATABASE_PASSWORD=change-me-database-password
# RDS accepts sslmode=require as-is. Use verify-full only if you also supply the
# RDS CA bundle and point PGSSLROOTCERT at it.
DATABASE_SSLMODE=require
DATABASE_CONN_MAX_AGE=60
DATABASE_WAIT_MAX_ATTEMPTS=30
DATABASE_WAIT_INTERVAL_SECONDS=2

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_CACHE_URL=redis://redis:6379/2
TRUSTED_PROXY_COUNT=1

# Where uploaded media lives. "filesystem" uses the shared private volume this
# Compose topology mounts into both web and worker. Use "s3" on any platform
# where web and worker run on separate hosts and cannot share a volume, such as
# Render: the worker opens the workbook PDF the web service saved, so per-host
# filesystems would break every workbook import. Any S3-compatible provider
# works (Cloudflare R2, Backblaze B2, AWS S3); only the endpoint differs.
MEDIA_STORAGE_BACKEND=filesystem
# Required only when MEDIA_STORAGE_BACKEND=s3. The bucket must be private.
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# Empty for real AWS S3. R2: https://<account-id>.r2.cloudflarestorage.com
# B2: https://s3.<region>.backblazeb2.com
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_REGION=auto
# "path" is needed by MinIO and some providers; most accept "virtual".
MEDIA_S3_ADDRESSING_STYLE=virtual
MEDIA_S3_URL_EXPIRE_SECONDS=300

# Which layer emits Content-Security-Policy and Permissions-Policy. Required in
# production, with no default: 0 for this Compose topology, where nginx supplies
# them (setting 1 here would send each header twice); 1 on a platform that routes
# straight to Django with no edge proxy, such as Render, where 0 would drop both
# headers entirely.
SECURITY_HEADERS_FROM_APP=0

# Disabled by default. If enabled, guests may enter only this demo classroom.
GUEST_LOGIN_ENABLED=0
GUEST_CLASSROOM_NAME=1001
# Keep disabled until opaque join codes or teacher approval are implemented.
PUBLIC_SIGNUP_ENABLED=0

# Used by Docker Compose/nginx/certificate operations; never secrets.
TLS_DOMAIN=bioinformatics-mod.sci-trek.org
# No second hostname for this deployment. Leave empty: a value here is added to
# nginx server_name and, if passed as the 3rd arg to scripts/init_tls.sh, to the
# certificate SAN.
TLS_WWW_DOMAIN=
TLS_EMAIL=change-me-operations-email

# Empty means same-origin API requests, which is recommended in production.
VITE_API_BASE_URL=
