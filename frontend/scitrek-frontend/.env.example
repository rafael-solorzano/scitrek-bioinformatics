# Optional. Leave empty for same-origin requests through nginx or the Vite proxy.
# If set, provide only the API origin/base and do not include the `/api` suffix.
# Example for a frontend served separately from a local Django backend:
# VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=

# Development-only proxy destination used by Vite. It is not the browser API URL.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
