{
  "name": "scitrek-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.7.2",
    "@hello-pangea/dnd": "^18.0.1",
    "@popperjs/core": "2.11.8",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "antd": "^5.26.5",
    "axios": "^1.9.0",
    "bootstrap": "^5.3.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.3",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage --no-file-parallelism",
    "e2e": "playwright test",
    "e2e:mocked": "playwright test",
    "e2e:fullstack": "playwright test -c playwright.fullstack.config.ts",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "verify-sitemap": "node scripts/verify-sitemap.js",
    "prebuild": "npm run generate-sitemap"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "^10.4.21",
    "jsdom": "28.1.0",
    "picomatch": "4.0.5",
    "postcss": "^8.5.6",
    "sitemap": "^9.0.0",
    "tailwindcss": "^3.4.14",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
